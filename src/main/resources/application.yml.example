spring:
  datasource:
    url: ${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/nanolink_db}
    username: ${SPRING_DATASOURCE_USERNAME:nanolink_user}
    password: ${SPRING_DATASOURCE_PASSWORD:${NANOLINK_DB_PASSWORD}}
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: false
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.PostgreSQLDialect
  flyway:
    enabled: true
    locations: classpath:db/migration

app:
  base-url: http://localhost:8080
  jwt:
    secret: ${NANOLINK_JWT_SECRET}
    expiration-ms: 604800000

server:
  port: 8080
