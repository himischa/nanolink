spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/nanolink_db
    username: nanolink_user
    password: yourpassword
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: false
    properties:
      hibernate:
        format_sql: true
        dialect: org.hibernate.dialect.PostgreSQLDialect
  flyway:
    enabled: true
    locations: classpath:db/migration

app:
  base-url: http://localhost:8080
  jwt:
    secret: changeme-replace-with-256-bit-secret
    expiration-ms: 604800000

server:
  port: 8080
