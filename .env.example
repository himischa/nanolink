# Database Configuration
# Choose a strong password (min 12 chars, mix of upper/lower/numbers/symbols)
NANOLINK_DB_PASSWORD=your_secure_db_password_here_change_me

# JWT Secret for token signing
# Must be at least 256 bits (base64 encoded ~32 chars)
# Generate: openssl rand -base64 32  (Linux/Mac)
#           [Convert]::ToBase64String((1..32|ForEach-Object{[byte](Get-Random -Max 256)})) | Out-String  (PowerShell)
NANOLINK_JWT_SECRET=your_256bit_random_secret_here_change_me
